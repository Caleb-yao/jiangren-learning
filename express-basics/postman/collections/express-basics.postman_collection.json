{
  "info": {
    "name": "Express Basics (Day 1)",
    "description": "GET / (JSON), req.params, req.query, req.body",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "GET / (hello json)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "GET /users/:id (req.params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users/1", "host": ["{{baseUrl}}"], "path": ["users", "1"] }
      }
    },
    {
      "name": "GET /users/:userId/posts/:postId (nested params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users/1/posts/9", "host": ["{{baseUrl}}"], "path": ["users", "1", "posts", "9"] }
      }
    },
    {
      "name": "GET /search?keyword=express (req.query)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search?keyword=express&page=2&size=5",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "keyword", "value": "express" },
            { "key": "page", "value": "2" },
            { "key": "size", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "POST /users (req.body)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Caleb\",\n  \"email\": \"caleb@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "POST /users (400 missing field)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Caleb\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "PUT /users/:id?notify=true (params+query+body)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Caleb Updated\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/users/1?notify=true",
          "host": ["{{baseUrl}}"],
          "path": ["users", "1"],
          "query": [{ "key": "notify", "value": "true" }]
        }
      }
    }
  ]
}
